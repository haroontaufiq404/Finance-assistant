# ---------------------------------------------------------------------------
# Supabase (SPEC §11). Get these from your project's API settings.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only; migrations/seed. NEVER expose to the client.

# ---------------------------------------------------------------------------
# Model providers — set the key(s) for the providers referenced below.
# ---------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=     # used by ROUTER_MODEL + VISION_MODEL
ANTHROPIC_API_KEY=                # used by REASONING_MODEL
OPENAI_API_KEY=                   # optional; only if you swap a tier to OpenAI

# ---------------------------------------------------------------------------
# Model tiering (provider:model strings, resolved in lib/agent/models.ts).
# Defaults below = "mixed, cheapest-capable": cheap router/vision, strong reasoner.
# Swap any line to change providers without touching code (SPEC §2).
# ---------------------------------------------------------------------------
ROUTER_MODEL=google:gemini-2.5-flash-lite
VISION_MODEL=google:gemini-2.5-flash
REASONING_MODEL=anthropic:claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Web search (Tier 3 merchant lookup). Tavily by default; Exa also supported.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
